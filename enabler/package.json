{
	"name": "enabler",
	"version": "1.0.2",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n VITE,TSC -c magenta,cyan \"vite --port 3000\" \"npm run tsc:dev\"",
		"docker:dev": "concurrently -n VITE,TSC -c magenta,cyan \"vite --host 0.0.0.0 --port 3000\" \"npm run tsc:dev\"",
		"tsc:dev": "tsc --noEmit --watch --preserveWatchOutput --pretty",
		"start": "serve public -l 8080 --cors",
		"lint": "prettier --check \"**/**/*.{ts,js,json,html}\"",
		"lint:fix": "prettier --write \"**/**/*.{ts,js,json,html}\"",
		"test": "jest --detectOpenHandles",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"serve": "npm run build && serve public -l 3000 --cors"
	},
	"dependencies": {
		"@commercetools/platform-sdk": "^8.23.0",
		"@commercetools/ts-client": "^4.1.0",
		"braintree-web-drop-in": "^1.46.0",
		"braintree-web": "^3.134.0",
		"cookie": "^1.1.1",
		"serve": "14.2.6"
	},
	"devDependencies": {
		"@types/braintree-web": "^3.96.17",
		"@types/braintree-web-drop-in": "^1.39.4",
		"@types/node": "24.10.1",
		"concurrently": "^9.2.1",
		"jest": "30.2.0",
		"prettier": "^3.7.4",
		"sass": "1.97.1",
		"ts-jest": "^29.4.6",
		"typescript": "5.9.3",
		"vite": "7.3.6",
		"vite-plugin-css-injected-by-js": "3.5.2"
	},
	"overrides": {
		"path-to-regexp": "3.3.0",
		"brace-expansion": "2.1.7",
		"browserslist": "4.29.2",
		"handlebars": "4.7.9",
		"immutable": "5.1.9",
		"js-yaml": "4.3.2",
		"minimatch": "9.0.9",
		"nanoid": "3.3.19",
		"picomatch": "4.0.7",
		"postcss": "8.5.28",
		"rollup": "4.63.5",
		"shell-quote": "1.11.0"
	}
}
