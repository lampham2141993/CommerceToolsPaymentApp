{
	"name": "payment-integration-braintree",
	"version": "1.0.2",
	"description": "Payment integration with Braintree",
	"main": "dist/server.js",
	"scripts": {
		"dev": "ts-node src/main.ts",
		"start": "node dist/main.js",
		"start:dev": "nodemon -q dist/main.js",
		"lint": "prettier --check \"**/**/*.{ts,js,json}\"",
		"lint:fix": "prettier --write \"**/**/*.{ts,js,json}\"",
		"build": "rm -rf dist && tsc",
		"watch": "nodemon --watch \"src/**\" --ext \"ts,json\" --ignore \"src/**/*.spec.ts\" --exec \"ts-node src/main.ts\"  --legacy-watch",
		"test": "jest --detectOpenHandles",
		"test:watch": "jest --watch --detectOpenHandles",
		"connector:post-deploy": "node dist/connectors/actions/postDeploy.js",
		"connector:pre-undeploy": "node dist/connectors/actions/preUndeploy.js"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@commercetools-backend/loggers": "24.11.0",
		"@commercetools/connect-payments-sdk": "0.24.0",
		"@fastify/autoload": "6.3.1",
		"@fastify/cors": "11.1.0",
		"@fastify/formbody": "8.0.2",
		"@fastify/http-proxy": "11.6.3",
		"@fastify/request-context": "6.2.1",
		"@fastify/static": "10.1.5",
		"@fastify/type-provider-typebox": "6.1.0",
		"@sinclair/typebox": "0.34.41",
		"braintree": "^3.34.0",
		"dotenv": "17.2.3",
		"fastify": "5.12.5",
		"fastify-plugin": "5.1.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.0",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.39.1",
		"@jest/globals": "30.2.0",
		"@types/braintree": "^3.4.2",
		"@types/jest": "30.0.0",
		"@types/node": "24.10.1",
		"@typescript-eslint/eslint-plugin": "8.47.0",
		"@typescript-eslint/parser": "8.47.0",
		"eslint": "9.39.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jest": "29.2.0",
		"eslint-plugin-prettier": "5.5.4",
		"eslint-plugin-unused-imports": "4.3.0",
		"globals": "^16.5.0",
		"jest": "30.2.0",
		"msw": "2.12.2",
		"node-fetch": "3.3.2",
		"nodemon": "3.1.11",
		"prettier": "3.6.2",
		"ts-jest": "29.4.5",
		"ts-node": "10.9.2",
		"typescript": "5.9.3"
	},
	"overrides": {
		"path-to-regexp": "3.3.0",
		"@fastify/reply-from": "12.6.5",
		"@isaacs/brace-expansion": "5.0.1",
		"brace-expansion": "2.1.7",
		"browserslist": "4.29.2",
		"fast-uri": "3.1.8",
		"find-my-way": "9.9.0",
		"flatted": "3.4.4",
		"handlebars": "4.7.9",
		"js-yaml": "4.3.2",
		"lodash": "4.18.1",
		"minimatch": "9.0.9",
		"picomatch": "4.0.7",
		"undici": "7.30.0",
		"ws": "8.22.0"
	}
}
